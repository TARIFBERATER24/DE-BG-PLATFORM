# Environment Variables rather than committing a real key to the repository.
NEXT_PUBLIC_SUPABASE_URL=https://dozkelizefwmmrfrawki.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

