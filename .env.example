# Public site URL, used by app/sitemap.ts and app/robots.ts.
# Set once a real domain is registered.
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase (Frankfurt/EU region) — not wired up yet, reserved for click-log
# persistence per the project plan. lib/click-log.ts currently only logs to
# the console; swap it to use these once a project exists.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Document-help demo storage. Configure these in Vercel Preview only; never commit values.
# BLOB_READ_WRITE_TOKEN=
# DOCUMENT_HELP_OPERATOR_CODE=
# DOCUMENT_HELP_SESSION_SECRET=
# GROQ_API_KEY=                   # Sensitive Preview-only secret for manual operator AI drafts.
# DOCUMENT_HELP_AI_MODEL=openai/gpt-oss-120b

# Regulator-sensitive service feature flags (lib/feature-flags.ts) — leave
# unset/false until the matching license/registration is actually held.
# See regulatorNote in lib/services.ts for what each one requires.
# NEXT_PUBLIC_FF_AUTO_INSURANCE_FINDER=true   # requires §34d/§34e GewO
# NEXT_PUBLIC_FF_BILL_CORRECTION=true         # requires §10 RDG or lawyer partner
# NEXT_PUBLIC_FF_FINANSI_LIVE=true            # requires confirmed CPA-only model (§34c GewO) + real CHECK24 tracking links
